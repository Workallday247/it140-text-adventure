# Project One Get-Item Pseudocode

START get_item
RECEIVE current_room and inventory from the main game

OUTPUT "Enter the name of the item to get."
INPUT requested_item

IF requested_item is in current_room THEN
    ADD requested_item to inventory
    REMOVE requested_item from current_room
    OUTPUT "You picked up " + requested_item
ELSE
    OUTPUT "That item is not in this room."
END IF 

RETURN inventory and current_room to the main game
END get_item
